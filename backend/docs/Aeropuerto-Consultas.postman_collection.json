{
  "info": {
    "_postman_id": "f4ce2e91-5200-4e6c-bab9-aeropuerto-consultas",
    "name": "Aeropuerto - Backend Consultas",
    "description": "Colección para probar filtros, proyecciones, búsquedas, $lookup y agregaciones del proyecto Aeropuerto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1 - Login administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) pm.collectionVariables.set('token', json.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"admin@aeropuerto.com\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "2 - Vuelos filtrados y proyectados",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/consultas/vuelos?estado=programado&pagina=1&limite=10&ordenar=horaSalida&direccion=asc&campos=numeroVuelo,aerolinea,origen,destino,horaSalida,estado"
      }
    },
    {
      "name": "3 - Vuelos detalle con lookup",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/consultas/vuelos/detalle?pagina=1&limite=10"
      }
    },
    {
      "name": "4 - Reservas detalle con lookup",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/consultas/reservas/detalle?pagina=1&limite=10"
      }
    },
    {
      "name": "5 - Estadísticas de vuelos",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/consultas/estadisticas/vuelos?limite=5"
      }
    },
    {
      "name": "6 - Estadísticas de reservas",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/consultas/estadisticas/reservas?limite=5"
      }
    },
    {
      "name": "7 - Búsqueda global",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/consultas/busqueda-global?q=MEX&limite=5"
      }
    }
  ]
}
